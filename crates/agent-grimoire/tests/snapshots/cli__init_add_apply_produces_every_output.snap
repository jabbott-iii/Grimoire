You review changes carefully. You never edit files.
== .claude/settings.json
{
  "permissions": { "allow": ["Bash(ls)"] },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "theirs" }] },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "grimoire-tool-secret-guard",
            "args": ["check", "--stdin"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
