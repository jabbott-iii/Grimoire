== grimoire.lock
== grimoire.toml
# Grimoire project configuration. `grimoire add` and `grimoire remove` edit it,
# and you can too; `grimoire apply` makes the project match it.
format = 1
clients = ["claude-code", "agents-md"]
bundles = ["security-baseline"]

[assets]
commit-style = "^1.0.0"
rust-errors = "^1.2.0"
adr-writer = "^0.3.1"
docs-index = { version = "^2.0.0", allow = ["filesystem-read", "env:DOCS_TOKEN"] }

[allow]
secret-guard = ["filesystem-read", "hooks"]
security-reviewer = ["filesystem-read"]
