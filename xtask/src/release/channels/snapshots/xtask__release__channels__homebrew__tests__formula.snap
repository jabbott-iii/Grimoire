# Generated by `cargo xtask release channels` for agent-grimoire 1.2.3.
# Do not edit: the tap's sync workflow replaces it from each release.
class AgentGrimoire < Formula
  desc "Install only the AI-agent assets you choose into your repository"
  homepage "https://github.com/jabbott-iii/Grimoire"
  license any_of: ["MIT", "Apache-2.0"]

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "https://github.com/jabbott-iii/Grimoire/releases/download/v1.2.3/agent-grimoire-1.2.3-aarch64-apple-darwin.tar.gz"
      sha256 "602526fe5d0720f8fb8f60272c924a754eb90c461381908e5d8a5f04f6e504c0"
    end

    on_intel do
      url "https://github.com/jabbott-iii/Grimoire/releases/download/v1.2.3/agent-grimoire-1.2.3-x86_64-apple-darwin.tar.gz"
      sha256 "838636fb51c7c295f53ac0becfa66f4e7726c388af3fc9397e57c97f5f97c840"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/jabbott-iii/Grimoire/releases/download/v1.2.3/agent-grimoire-1.2.3-aarch64-unknown-linux-musl.tar.gz"
      sha256 "38990144ad7c86a796fa7844440da54dbc1ca481e48f87796209d8a9f5d26611"
    end

    on_intel do
      url "https://github.com/jabbott-iii/Grimoire/releases/download/v1.2.3/agent-grimoire-1.2.3-x86_64-unknown-linux-musl.tar.gz"
      sha256 "11a7f97d7c53e609ba9fb10d25657f4474d2bfc81353533ddaec0ab2ca688e9c"
    end
  end

  def install
    bin.install "grimoire"
  end

  test do
    assert_match "grimoire #{version}", shell_output("#{bin}/grimoire --version")
  end
end
